# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_SERVERS=nats://localhost:4222

# ── Monolith (Java) base URL — used by gateway-api proxy ─────────────────────
MONOLITH_BASE_URL=http://localhost:8090

# ── PostgreSQL — used by audit-service ───────────────────────────────────────
DATABASE_URL=******localhost:5432/entcore_audit

# ── Neo4j — used by organization-service ─────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── OpenTelemetry / Jaeger ────────────────────────────────────────────────────
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ── Service ports ─────────────────────────────────────────────────────────────
# gateway-api:          PORT=3000
# notification-service: PORT=3001
# audit-service:        PORT=3002
# communication-service:PORT=3003
# organization-service: PORT=3004
# profile-service:      PORT=3005
# identity-service:     PORT=3006
# content-service:      PORT=3007
PORT=3000
